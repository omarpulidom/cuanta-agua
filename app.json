{
  "expo": {
    "name": "¿Cuánta agua?",
    "slug": "cuanta-agua",
    "version": "0.0.1",
    "scheme": "com.pm.cuantaagua",
    "platforms": ["ios", "android"],
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-font",
      [
        "expo-asset",
        {
          "assets": [
            "./src/assets/images",
            "./src/assets/data"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5f5f5",
          "image": "./src/assets/appIcons/adaptive-icon.png",
          "imageWidth": 150
        }
      ]
    ],
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./src/assets/appIcons/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pm.cuantaagua",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "MGLMapboxAccessToken": "$(EXPO_PUBLIC_MAPBOX_TOKEN)"
      },
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/appIcons/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.pm.cuantaagua",
      "versionCode": 1,
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "extra": {
      "router": {
        "origin": false
      }
    },
    "owner": "omarf045"
  }
}
